{{#get "tags" filter="slug:-klar" limit="all" order="name asc"}}
    {{#if tags}}
    <nav class="tag-filter">
        <button class="tag-filter-link{{#unless ../active_tag_slug}} tag-filter-active{{/unless}}"
            type="button"
            hx-get="{{@site.url}}"
            hx-target=".site-content"
            hx-swap="outerHTML"
            hx-select=".site-content"
            hx-push-url="true"
        >{{t "Visa alla"}}</button>
        {{#foreach tags}}
            <button class="tag-filter-link{{#match slug ../../active_tag_slug}} tag-filter-active{{/match}}"
                type="button"
                hx-get="{{url}}"
                hx-target=".site-content"
                hx-swap="outerHTML"
                hx-select=".site-content"
                hx-push-url="true"
            >{{name}}</button>
        {{/foreach}}
    </nav>
    {{/if}}
{{/get}}
