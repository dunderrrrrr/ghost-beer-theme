{{!< default}}

<main class="site-main">

    {{#post}}

    <article class="gh-article {{post_class}}">

        <header class="gh-article-header gh-canvas">
            <span class="gh-article-meta"{{#if primary_tag.accent_color}} style="--tag-color: {{primary_tag.accent_color}};"{{/if}}>
            {{{t "{authors}" authors=(authors) }}} @ <time datetime="{{date format="YYYY-MM-DD"}}">{{date format="DD MMM YYYY"}}</time> —
                {{#if primary_tag}}
{{{t "{primaryTag}" primaryTag=(concat "<a class=\"gh-article-tag\" hx-get=\"" primary_tag.url "\" hx-target=\".site-content\" hx-swap=\"outerHTML\" hx-select=\".site-content\" hx-push-url=\"true\">" primary_tag.name "</a>")}}}
                {{/if}}
            </span>

            <h1 class="gh-article-title">{{title}}</h1>

            {{#if custom_excerpt}}
                <p class="gh-article-excerpt">{{custom_excerpt}}</p>
            {{/if}}

            {{> "post-image"}}
        </header>

        <div class="gh-content gh-canvas">
            {{content}}

            <hr style="margin: 30px 0px 10px 0px;">
            <div id="remark42" data-remark-url="https://bryggis.se{{url}}">Laddar kommentarer...</div>
            <script>
                (function () {
                    function buildConfig(el) {
                        return {
                            host: "https://c.bryggis.se",
                            site_id: "bryggis",
                            url: el.getAttribute('data-remark-url'),
                            theme: 'dark',
                            show_email_subscription: false,
                            simple_view: true,
                            no_footer: true,
                            style: "https://bryggis.se/remark-custom.css"
                        };
                    }

                    function mount() {
                        var el = document.getElementById('remark42');
                        if (!el) return;
                        var config = buildConfig(el);
                        window.remark_config = config;

                        if (window.REMARK42 && typeof window.REMARK42.createInstance === 'function') {
                            window.REMARK42.createInstance(config);
                        } else if (!window.__remark42ScriptLoading) {
                            window.__remark42ScriptLoading = true;
                            var script = document.createElement('script');
                            script.type = 'module';
                            script.async = true;
                            script.defer = true;
                            script.src = config.host + '/web/embed.mjs';
                            (document.head || document.body).appendChild(script);
                        }
                    }

                    mount();

                    if (!window.__remark42HtmxBound) {
                        window.__remark42HtmxBound = true;
                        document.addEventListener('htmx:afterSwap', mount);
                    }
                })();
            </script>

        </div>

    </article>

    {{> "post-navigation"}}



    {{#if comments}}
        <div class="gh-comments gh-canvas">
            {{comments}}
        </div>
    {{/if}}

    {{/post}}

    {{#if @custom.show_related_posts}}
        {{> "related-posts"}}
    {{/if}}

</main>
